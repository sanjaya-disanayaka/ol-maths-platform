generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  lessons     Lesson[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  order     Int
  createdAt DateTime @default(now())

  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}